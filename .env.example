# Copy to .env and fill in. .env is git-ignored and never copied into an image.

# gemini (free tier, default) | anthropic (paid) | nvidia (free for development, text only)
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# NVIDIA_API_KEY=
# LLM_MODEL=gemini-3.5-flash-lite

# Protects the HTTP API (the review screen sends it). Leave empty on localhost.
APP_API_KEY=
